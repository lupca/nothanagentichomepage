# Lead capture — email delivery (app/api/lead/route.ts)
#
# RESEND_API_KEY
#   API key for the Resend HTTP email API (https://resend.com). When set,
#   every lead/partner form submission is sent as an email so leads are not
#   lost on hosts with an ephemeral filesystem (e.g. Vercel, Netlify).
#   If this is NOT set, the route falls back to file-only persistence
#   (data/leads.jsonl) and logs a warning on each submission — fine for a
#   VPS with a persistent disk, but leads will be lost on serverless hosts.
RESEND_API_KEY=

# LEAD_NOTIFY_TO
#   Recipient address for lead notification emails. Defaults to
#   support@nothanagentic.vn when unset.
LEAD_NOTIFY_TO=support@nothanagentic.vn

# LEAD_NOTIFY_FROM
#   "From" address/name used when sending lead notification emails via
#   Resend. Must be a domain verified with Resend (or Resend's shared
#   onboarding@resend.dev sender for testing).
LEAD_NOTIFY_FROM="Lead Notifier <onboarding@resend.dev>"
