# Lead capture — email delivery (app/api/lead/route.ts)
#
# This site is deployed on Vercel, whose filesystem is read-only outside of
# /tmp, and /tmp does not persist between invocations. That means a local
# file write is NOT durable storage there.
#
# RESEND_API_KEY
#   API key for the Resend HTTP email API (https://resend.com). When set,
#   every lead/partner form submission is sent as an email so leads are not
#   lost on hosts with an ephemeral filesystem (e.g. Vercel, Netlify).
#
#   On Vercel this variable is REQUIRED. If it is NOT set, the route has no
#   durable place to put a submission and will return an error response
#   instead of silently accepting it — it will NOT fall back to writing
#   data/leads.jsonl, because that file would not survive past the request.
#
#   On a VPS/self-hosted deployment with a persistent disk, this can be left
#   unset; see LEAD_STORAGE_DURABLE below to enable the file fallback there.
RESEND_API_KEY=

# LEAD_STORAGE_DURABLE
#   Set to "true" only on a self-hosted/VPS deployment that has a real
#   persistent disk. This tells the route it's safe to treat a local
#   data/leads.jsonl append as durable storage, so submissions can still
#   succeed without RESEND_API_KEY configured. Leave unset on Vercel — the
#   route already detects Vercel automatically (via the VERCEL env var it
#   sets) and treats its filesystem as non-durable.
LEAD_STORAGE_DURABLE=

# LEAD_NOTIFY_TO
#   Recipient address for lead notification emails. Defaults to
#   support@nothanagentic.vn when unset.
LEAD_NOTIFY_TO=support@nothanagentic.vn

# LEAD_NOTIFY_FROM
#   "From" address/name used when sending lead notification emails via
#   Resend. Must be a domain verified with Resend (or Resend's shared
#   onboarding@resend.dev sender for testing).
LEAD_NOTIFY_FROM="Lead Notifier <onboarding@resend.dev>"
